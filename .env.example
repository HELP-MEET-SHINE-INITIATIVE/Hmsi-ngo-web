# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public browser key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key; never expose this in client code or commit its value
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional; defaults to fundraiser-images
SUPABASE_STORAGE_BUCKET=fundraiser-images

# Existing payment configuration
NEXT_PUBLIC_PAYSTACK_KEY=your-paystack-public-key
# Server-only Paystack secret used to verify successful payments
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Official transactional delivery (server-only key; sender identities are defined in lib/hmsiNotifications.ts)
RESEND_API_KEY=re_your-server-key
# Optional: send an executive major-donation alert only when a verified NGN payment meets this threshold.
HMSI_MAJOR_DONATION_THRESHOLD_NGN=500000
NEXT_PUBLIC_SITE_URL=https://www.hmsi.org.ng

# Private admin login; use a unique email and a long random password
HMSI_ADMIN_EMAIL=replace-with-private-admin-login-email
HMSI_ADMIN_PASSWORD=replace-with-a-long-random-password
HMSI_ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Server-only Manus API key used by the HMSI Assistant; never expose to the browser
MANUS_API_KEY=manus-your-server-key
